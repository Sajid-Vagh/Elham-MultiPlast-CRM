# =============================================================================
# Stage 1: install all workspace dependencies
# =============================================================================
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

# Only the packages the CRM workspace needs
COPY lib/api-zod/package.json            lib/api-zod/
COPY lib/api-client-react/package.json   lib/api-client-react/
COPY artifacts/crm/package.json          artifacts/crm/

RUN pnpm install --frozen-lockfile


# =============================================================================
# Stage 2: build the Vite SPA
# Node_modules stay in /repo here (same stage = no symlink copy issue).
# The output is pure static HTML/JS/CSS - no node_modules in production.
# =============================================================================
FROM deps AS build

WORKDIR /repo

COPY lib/api-zod/           lib/api-zod/
COPY lib/api-client-react/  lib/api-client-react/
COPY artifacts/crm/         artifacts/crm/
COPY tsconfig.base.json     ./

# Build-time args — Vite bakes VITE_API_URL into the JS bundle
ARG VITE_API_URL
ARG PORT=80
ARG BASE_PATH=/

WORKDIR /repo/artifacts/crm

RUN PORT=${PORT} BASE_PATH=${BASE_PATH} API_PORT=8080 \
    VITE_API_URL=${VITE_API_URL} \
    pnpm run build


# =============================================================================
# Stage 3: serve static files with nginx
# No node_modules needed - only the built dist/ is copied.
# =============================================================================
FROM nginx:1.27-alpine AS production

# API_PROXY_URL: nginx proxy target for /api and /socket.io routes.
# Must be set at container runtime — Dokploy: add to project-level environment variables.
# Intentionally NO hardcoded default. The entrypoint validates this before starting nginx.
# Vercel does NOT use this Dockerfile — it is only used by Docker/Dokploy deployments.
ENV API_PROXY_URL=""

RUN rm /etc/nginx/conf.d/default.conf

COPY --from=build /repo/artifacts/crm/dist/public /usr/share/nginx/html

# Write the nginx template — uses envsubst at container startup via the entrypoint.
RUN mkdir -p /etc/nginx/templates && printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
\n\
  # SPA fallback: unknown paths -> index.html (client-side routing)\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
\n\
  # Proxy /api to the backend URL\n\
  location /api/ {\n\
    proxy_pass ${API_PROXY_URL}/api/;\n\
    proxy_set_header Host $proxy_host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $scheme;\n\
  }\n\
\n\
  # Proxy /socket.io to the backend URL\n\
  location /socket.io/ {\n\
    proxy_pass ${API_PROXY_URL}/socket.io/;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Upgrade $http_upgrade;\n\
    proxy_set_header Connection "Upgrade";\n\
    proxy_set_header Host $proxy_host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
  }\n\
\n\
  # Aggressive caching for hashed static assets\n\
  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
    expires 1y;\n\
    add_header Cache-Control "public, immutable";\n\
  }\n\
\n\
  # Health check endpoint for Dokploy\n\
  location /health {\n\
    return 200 "ok";\n\
    add_header Content-Type text/plain;\n\
  }\n\
}\n' > /etc/nginx/templates/default.conf.template

# Entrypoint: validate API_PROXY_URL then start nginx via the official template mechanism.
# The official nginx image runs envsubst on /etc/nginx/templates/*.template → /etc/nginx/conf.d/
# before calling nginx -g 'daemon off;'.
# We add an explicit guard so a missing/empty API_PROXY_URL fails with a clear error
# instead of producing an invalid nginx config (proxy_pass with no URL = nginx parse error).
RUN printf '#!/bin/sh\n\
set -e\n\
if [ -z "${API_PROXY_URL}" ]; then\n\
  echo "ERROR: API_PROXY_URL is not set."\n\
  echo "Set API_PROXY_URL to the backend API base URL in Dokploy environment variables."\n\
  echo "Example: API_PROXY_URL=https://api.elhammultiplast.com"\n\
  exit 1\n\
fi\n\
# Delegate to the official nginx entrypoint which runs envsubst then starts nginx\n\
exec /docker-entrypoint.sh nginx -g "daemon off;"\n' > /docker-entrypoint-guard.sh \
  && chmod +x /docker-entrypoint-guard.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:80/health || exit 1

CMD ["/docker-entrypoint-guard.sh"]

