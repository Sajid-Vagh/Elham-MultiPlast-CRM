{
  "crons": [
    {
      "path": "/api/notifications/cleanup-expired",
      "schedule": "30 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://test-api.elhammultiplast.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
