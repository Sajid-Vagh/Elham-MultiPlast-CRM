{
  "crons": [
    {
      "path": "/api/notifications/cleanup-expired?key=CRON_SECRET_PLACEHOLDER",
      "schedule": "30 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://elham-multiplast-crm.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
