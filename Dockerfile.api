# =============================================================================
# Stage 1: install ALL workspace deps with --shamefully-hoist
# This produces a flat node_modules (no symlinks) that Docker can copy safely.
# =============================================================================
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

COPY lib/db/package.json                     lib/db/
COPY lib/api-zod/package.json                lib/api-zod/
COPY lib/api-client-react/package.json       lib/api-client-react/
COPY artifacts/api-server/package.json       artifacts/api-server/

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# --shamefully-hoist = traditional flat layout, real files, no symlinks
RUN pnpm install --frozen-lockfile --shamefully-hoist


# =============================================================================
# Stage 2: build — esbuild bundles all @workspace/* deps into dist/index.mjs
# =============================================================================
FROM deps AS build

WORKDIR /repo

COPY lib/                   lib/
COPY artifacts/api-server/  artifacts/api-server/
COPY tsconfig.base.json     ./

WORKDIR /repo/artifacts/api-server
RUN pnpm run build


# =============================================================================
# Stage 3: production — install only prod deps (flat) for the final image
# =============================================================================
FROM node:22-alpine AS prod-deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

COPY lib/db/package.json                     lib/db/
COPY lib/api-zod/package.json                lib/api-zod/
COPY lib/api-client-react/package.json       lib/api-client-react/
COPY artifacts/api-server/package.json       artifacts/api-server/

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# --prod skips devDependencies so the copied node_modules stays lean
RUN pnpm install --frozen-lockfile --shamefully-hoist --prod


# =============================================================================
# Stage 4: minimal production image — non-root
# =============================================================================
FROM node:22-alpine AS production

RUN addgroup -g 1001 -S appgroup && adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

COPY --from=build     --chown=appuser:appgroup /repo/artifacts/api-server/dist        ./dist
COPY --from=build     --chown=appuser:appgroup /repo/artifacts/api-server/scripts     ./scripts
COPY --from=build     --chown=appuser:appgroup /repo/artifacts/api-server/package.json ./package.json
# Flat real-file node_modules — contains nodemailer, xlsx, etc. that esbuild externalized
COPY --from=prod-deps --chown=appuser:appgroup /repo/node_modules                     ./node_modules

RUN mkdir -p /app/uploads && chown appuser:appgroup /app/uploads

USER appuser

ENV NODE_ENV=production
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/health || exit 1

CMD ["node", "--import", "./scripts/load-env.mjs", "--enable-source-maps", "./dist/index.mjs"]
