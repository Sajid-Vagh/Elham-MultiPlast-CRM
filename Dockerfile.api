# =============================================================================
# Stage 1: install all workspace dependencies
# =============================================================================
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

# Copy all package.json files the workspace needs
COPY lib/db/package.json                     lib/db/
COPY lib/api-zod/package.json                lib/api-zod/
COPY lib/api-client-react/package.json       lib/api-client-react/
COPY artifacts/api-server/package.json       artifacts/api-server/

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
RUN pnpm install --frozen-lockfile


# =============================================================================
# Stage 2: build lib/* packages then the api-server
# =============================================================================
FROM deps AS build

WORKDIR /repo

COPY lib/                   lib/
COPY artifacts/api-server/  artifacts/api-server/
COPY tsconfig.base.json     ./

# esbuild bundles all @workspace/* deps inline -> dist/index.mjs
WORKDIR /repo/artifacts/api-server
RUN pnpm run build

# =============================================================================
# Stage 3: pnpm deploy - creates a flat, symlink-free node_modules with only
# the npm packages that esbuild externalized (nodemailer, xlsx, etc.)
# This is the correct pnpm way to prepare a production deployment folder.
# =============================================================================
FROM deps AS deploy

WORKDIR /repo

COPY lib/                   lib/
COPY artifacts/api-server/  artifacts/api-server/
COPY tsconfig.base.json     ./

# pnpm deploy resolves workspace: deps and creates a self-contained
# /api-deploy/node_modules with a flat structure Node.js can resolve normally
RUN pnpm --filter @workspace/api-server deploy --prod --legacy /api-deploy


# =============================================================================
# Stage 4: minimal production image - non-root
# =============================================================================
FROM node:22-alpine AS production

RUN addgroup -g 1001 -S appgroup && adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

# Compiled bundle from the build stage
COPY --from=build  --chown=appuser:appgroup /repo/artifacts/api-server/dist    ./dist
COPY --from=build  --chown=appuser:appgroup /repo/artifacts/api-server/scripts ./scripts
COPY --from=build  --chown=appuser:appgroup /repo/artifacts/api-server/package.json ./package.json

# Flat, symlink-free node_modules from pnpm deploy (contains nodemailer, xlsx, etc.)
COPY --from=deploy --chown=appuser:appgroup /api-deploy/node_modules           ./node_modules

RUN mkdir -p /app/uploads && chown appuser:appgroup /app/uploads

USER appuser

ENV NODE_ENV=production
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/api/healthz || exit 1

CMD ["node", "--import", "./scripts/load-env.mjs", "--enable-source-maps", "./dist/index.mjs"]
