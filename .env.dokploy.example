# =============================================================================
# Elham CRM — Dokploy Environment Variables Template
#
# Copy this file, rename it .env.dokploy, and fill in real values.
# Then add .env.dokploy to .gitignore (never commit real secrets).
#
# In Dokploy you can paste these directly in the "Environment Variables" UI
# instead of using an env_file — either approach works.
# =============================================================================


# -- Domains (used by Traefik labels in docker-compose.dokploy.yml) ----------
# The public hostname for the API server
API_DOMAIN=api.elham.com

# The public hostname for the CRM frontend
CRM_DOMAIN=app.elham.com

# The full URL of the API — baked into the CRM at build time via Vite
# Must match the API_DOMAIN above (with https://)
VITE_API_URL=https://api.elham.com


# -- API Server ---------------------------------------------------------------

# Node port inside the api container (must match Dockerfile EXPOSE)
PORT=8080

# Strong random secret for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# Base path (leave as / unless deploying to a sub-path)
BASE_PATH=/

# CORS — comma-separated allowed origins for the browser
CORS_ORIGINS=https://app.elham.com

# Frontend URL used in emailed links (reset password, verify email, invitations)
FRONTEND_URL=https://app.elham.com


# -- Database (Supabase PostgreSQL) -------------------------------------------
# Use the pooler URL from Supabase Dashboard ? Settings ? Database ? Connection pooling
DATABASE_URL=postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true


# -- Supabase Storage ---------------------------------------------------------
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_KEY=sb_publishable_XXXX
# Service role key — bypasses RLS for server-side storage ops. Get from:
# Supabase Dashboard ? Project Settings ? API ? service_role (SECRET — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXX


# -- SMTP (email — password reset, verification, invitations) -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=your@gmail.com


# -- Google OAuth (optional) --------------------------------------------------
# Leave empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -- First-Admin Bootstrap ----------------------------------------------------
# Only this email may register the first Admin account.
# Must match exactly (normalized to lowercase).
BOOTSTRAP_ADMIN_EMAIL=admin@elham.com


# -- GST Lookup APIs ----------------------------------------------------------
GSTVERIFY_API_KEY=gstv_XXXX
GSTVERIFY_BASE_URL=https://gstverify.co.in/api

GST_API_URL=https://my.gstzen.in/api/gstin-validator/
GST_API_KEY=XXXX

RAPIDAPI_GST_KEY=XXXX
RAPIDAPI_GST_HOST=india-gstin-validator-api.p.rapidapi.com
